# Copy to .env.local. Each team creates its own keys; never commit real ones.

# ScorePlay MAM. Sent as the X-ScorePlay-Api-Key header.
SCOREPLAY_API_KEY=
SCOREPLAY_API_URL=https://media.scoreplay.io/v1

# Twelve Labs. The base index already holds every match video.
TWELVELABS_API_KEY=
TWELVELABS_INDEX_ID=

# Optional engine settings. See docs/engine.md.
# TWELVELABS_PEGASUS_MODEL=pegasus1.6
# TWELVELABS_SCOREPLAY_ID_KEY=
# RUNDOWN_DATA_DIR=.rundown

# Optional social clip settings. Rendering needs ffmpeg on the server.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# RUNDOWN_FONT=/System/Library/Fonts/Supplemental/Arial Bold.ttf
# RUNDOWN_HASHTAGS=#COYS,#THFC
